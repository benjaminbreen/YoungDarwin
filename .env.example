# Young Darwin — environment configuration
#
# Copy this file to `.env.local` and fill in the values you need:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and must never be committed. Every value below is
# optional except the API keys: the game boots and is fully playable without
# them, but the generated narration, examination, and encounter text falls back
# to canned copy.
#
# Values shown after `=` are the defaults baked into the code. Uncomment a line
# only when you want to override it.


# ---------------------------------------------------------------------------
# Player-visible generation
# ---------------------------------------------------------------------------

# The narrator composer and /api/three-narrate are enabled by default, including
# on Vercel. Set both values to 0 to hide the composer and reject narrator API
# requests before any provider work. The legacy all-generation values are used
# as fallbacks when these narrator-specific overrides are unset.
# YOUNG_DARWIN_ENABLE_NARRATOR=0
# NEXT_PUBLIC_YOUNG_DARWIN_ENABLE_NARRATOR=0

# Free-form NPC dialogue, specimen examination, and generated assessment remain
# opt-in and require matching server/client values.
# YOUNG_DARWIN_ENABLE_GENERATIVE=1
# NEXT_PUBLIC_YOUNG_DARWIN_ENABLE_GENERATIVE=1


# ---------------------------------------------------------------------------
# API keys — set at least one provider
# ---------------------------------------------------------------------------

# Google Gemini. GEMINI_API_KEY is checked first, GOOGLE_API_KEY is the
# fallback; set either one. Required for the default model (gemini-flash-lite).
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# OpenAI. Required for the `openai-fast` / `openai-small` models and for the
# hybrid specimen image endpoint.
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# Cost and abuse controls  (utils/server/llmSafety.js)
# ---------------------------------------------------------------------------
# These are the guardrails that keep a class full of students from running up
# an unbounded bill. NOTE: the ledger is in-process memory, so on a serverless
# host (Vercel) these caps are enforced per instance, not globally — treat them
# as a safety net, not a hard budget.

# LLM_MAX_CALLS_PER_SESSION=80
# LLM_MAX_CALLS_PER_MINUTE=12
# LLM_MAX_BACKGROUND_CALLS_PER_MINUTE=4
# LLM_MAX_ESTIMATED_TOKENS_PER_SESSION=120000
# LLM_MAX_PENDING_PER_SESSION=3
# LLM_MAX_PENDING_GLOBAL=10

# How long an identical request is de-duplicated, in ms (default 2 minutes).
# LLM_IDEMPOTENCY_TTL_MS=120000
# How many recent calls the usage ledger retains for /api/llm-usage.
# LLM_LEDGER_LIMIT=300


# ---------------------------------------------------------------------------
# Model selection
# ---------------------------------------------------------------------------

# Default model alias. One of the `id` values in utils/server/llmProvider.js:
# gemini-flash-lite | gemini-fast | gemini-small | openai-fast | openai-small
# YOUNG_DARWIN_DEFAULT_MODEL=gemini-flash-lite

# Per-feature overrides. Each takes a model alias as above; unset means the
# feature uses YOUNG_DARWIN_DEFAULT_MODEL.
# YOUNG_DARWIN_NARRATIVE_MODEL=
# YOUNG_DARWIN_SUMMARY_MODEL=
# YOUNG_DARWIN_3D_MODEL=
# YOUNG_DARWIN_COLLECTION_MODEL=
# YOUNG_DARWIN_ASSESSMENT_MODEL=
# YOUNG_DARWIN_CRITIQUE_MODEL=
# YOUNG_DARWIN_HYBRID_MODEL=

# Underlying provider model IDs that the aliases resolve to. Change these when
# a provider retires a model, rather than editing the alias table.
# GOOGLE_SMALL_MODEL=gemini-3.1-flash-lite
# GOOGLE_FAST_MODEL=gemini-2.0-flash
# GOOGLE_LEGACY_MODEL=gemini-2.0-flash
# OPENAI_FAST_MODEL=gpt-5.4-mini
# OPENAI_SMALL_MODEL=gpt-5.4-nano
# OPENAI_IMAGE_MODEL=dall-e-2


# ---------------------------------------------------------------------------
# Multiplayer
# ---------------------------------------------------------------------------

# WebSocket URL of the Cloudflare Worker room server. Empty disables
# multiplayer in the client. Run `npm run multiplayer:dev` for a local worker,
# or `npm run multiplayer:deploy` and use the deployed URL.
# NEXT_PUBLIC_MULTIPLAYER_URL=


# ---------------------------------------------------------------------------
# Feedback email
# ---------------------------------------------------------------------------

# The in-game Feedback panel posts to /api/feedback, which relays by email.
# Use a Gmail "app password" (Google Account > Security > 2-Step Verification
# > App passwords), NOT the account password. Without these the panel falls
# back to a mailto: link, so feedback still works, just less smoothly.
# FEEDBACK_GMAIL_USER=you@gmail.com
# FEEDBACK_GMAIL_APP_PASSWORD=
# Defaults to breen85@gmail.com when unset.
# FEEDBACK_TO_ADDRESS=


# ---------------------------------------------------------------------------
# Development and debugging
# ---------------------------------------------------------------------------

# Expose the dev-only routes (/legacy, /sky-test, /altpostoffice,
# /postofficebay3) in a production build. They are always available under
# `npm run dev`. Leave unset for a public beta — see app/devRoutes.js.
# YOUNG_DARWIN_ENABLE_DEV_ROUTES=1

# Verbose server logging for /api/generate.
# YOUNG_DARWIN_DEBUG_LLM=1

# Show the in-page LLM usage HUD in a production build (always on in dev).
# NEXT_PUBLIC_SHOW_LLM_HUD=true

# Force the older HUD layout. Set to `legacy` for the pre-polish chrome.
# NEXT_PUBLIC_THREE_HUD_LAYOUT=legacy

# Hybrid specimen image batching.
# NEXT_PUBLIC_DEFAULT_HYBRID_BATCH_SIZE=3
# NEXT_PUBLIC_MAX_HYBRID_BATCH_SIZE=4
# IMAGE_MAX_RETRIES=1
